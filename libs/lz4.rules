# Extremely Fast Compression algorithm
# shellcheck disable=SC2034

libs_name=lz4
libs_lic="BSD-2-Clause"
libs_ver=1.11.1
libs_rev=1
libs_url=https://github.com/lz4/lz4/releases/download/v$libs_ver/lz4-$libs_ver.tar.gz
libs_sha=683fed08a844ad012196381e40badf80c0bbe4962959761416d41c9e67d77ec7
libs_dep=()

libs_args=(
    -DBUILD_SHARED_LIBS=OFF
)

libs_build() {
    pushd build/cmake

    cmake.setup

    cmake.build

    cmdlet.pkgfile liblz4 -- cmake.install

    cmdlet.install ./lz4 lz4 unlz4 lz4c lz4cat

    echo "test" > foo && rm -f foo.lz4
    cmdlet.verify lz4 << EOF
    lz4 foo                                 || die "lz4 compress failed."
    lz4 -t foo.lz4                          || die "lz4 integrity test failed."
    lz4 --list foo.lz4 | grep -Fwq foo      || die "lz4 list contents failed."
    lz4 -d -c foo.lz4 | grep -Eq "^test$"   || die "lz4 decompress failed."
EOF
}

# vim:ft=sh:syntax=bash:ff=unix:fenc=utf-8:et:ts=4:sw=4:sts=4
