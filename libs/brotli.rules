# Generic-purpose lossless compression algorithm by Google
#
# shellcheck disable=SC2034

libs_lic="MIT"
libs_ver=1.2.1
libs_rev=1
libs_url=https://github.com/google/brotli/archive/refs/tags/v1.2.1.tar.gz
libs_sha=98d35d11a78dc453aebb7d10c3748f3f73ff78c8267c0dc697b8631f67bf7e8f
libs_dep=()

libs_args=(
    -DBROTLI_BUILD_TOOLS=OFF

    -DBUILD_SHARED_LIBS=OFF
)

libs_build() {

    cmake.setup

    cmake.build

    cmdlet.pkgfile libbrotli -- cmake.install --component Unspecified
}

