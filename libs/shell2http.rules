# Executing shell commands via HTTP server

# shellcheck disable=SC2034
libs_lic="MIT"
libs_ver=1.18.0
libs_rev=1
libs_url=https://github.com/msoap/shell2http/archive/refs/tags/v1.18.0.tar.gz
libs_sha=0182c5d5a4574f7c932172001378132d99ed9b41432d159d70e3a19ef3c29145
libs_dep=( )

libs_args=(
)

libs_build() {
    go.setup

    go.build -tags release -o "$libs_name"

    cmdlet.install "$libs_name"

    cmdlet.verify -- "$libs_name" -v
}

