# Minimalistic client for Redis

# shellcheck disable=SC2034
libs_lic='BSD-3-Clause'
libs_ver=1.5.1
libs_rev=1
libs_url=https://github.com/redis/hiredis/archive/refs/tags/v1.5.1.tar.gz
libs_sha=f5ec19151c0f4f15ca018c22b17b6f6739a672a4fc0c085b692aef69a154ebef
libs_dep=(openssl)

libs_args=(
    -DENABLE_SSL=ON

    -DDISABLE_TESTS=ON

    -DBUILD_SHARED_LIBS=OFF
)

libs_build() {
    cmake.setup

    cmake.build

    cmdlet.pkgfile libhiredis -- cmake.install
}

# vim:ft=sh:syntax=bash:ff=unix:fenc=utf-8:et:ts=4:sw=4:sts=4
