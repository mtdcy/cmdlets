# Minimalistic client for Redis

# shellcheck disable=SC2034
libs_lic='BSD-3-Clause'
libs_ver=1.5.0
libs_rev=1
libs_url=https://github.com/redis/hiredis/archive/refs/tags/v1.5.0.tar.gz
libs_sha=eec7ef8641d221e144a58d5ef8d733c8c75c7fd487097a233aacb4fa33981cfb
libs_dep=(openssl)

libs_args=(
    -DENABLE_SSL=ON

    -DDISABLE_TESTS=ON

    -DBUILD_SHARED_LIBS=OFF
)

libs_build() {
    cmake.setup

    cmake.build

    cmdlet.pkgfile libhiredis -- cmake.install
}

