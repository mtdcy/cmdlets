# Simple, fast and user-friendly alternative to find

# shellcheck disable=SC2034
libs_lic=MIT
libs_ver=10.5.2
libs_rev=1
libs_url=https://github.com/sharkdp/fd/archive/refs/tags/v10.5.2.tar.gz
libs_sha=8991b6504cac33c00528050622dfe3f2a0db1be1a6faf99f69b46d1a8f737dc5
libs_dep=( libpcap )

# configure args
libs_args=(
)

libs_build() {

    cargo.setup

    cargo.build

    cmdlet.install "$(cargo.locate $libs_name)"

    cmdlet.verify -- "$libs_name" --version
}

