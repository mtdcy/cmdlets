# Simple, fast and user-friendly alternative to find

# shellcheck disable=SC2034
libs_lic=MIT
libs_ver=10.5.1
libs_rev=1
libs_url=https://github.com/sharkdp/fd/archive/refs/tags/v10.5.1.tar.gz
libs_sha=3ea70c258d3390a601b436b6f4c545e3a944ff3de44c8ee5542c05588e337032
libs_dep=( libpcap )

# configure args
libs_args=(
)

libs_build() {

    cargo.setup

    cargo.build

    cmdlet.install "$(cargo.locate $libs_name)"

    cmdlet.verify -- "$libs_name" --version
}

