# Cross-platform TUI database management tool

# shellcheck disable=SC2034
libs_lic=MIT
libs_ver=0.6.0
libs_rev=1
libs_url=https://github.com/jorgerojas26/lazysql/archive/refs/tags/v0.6.0.tar.gz
libs_sha=7f3c7d7838e3bd492261f992a5941debe22b2c4ba7e12faa4f8be040079986ac

libs_args=(
)

libs_build() {
    go.setup

    go.build

    cmdlet.install "$libs_name"

    cmdlet.verify -- "$libs_name" --version
}

