# Cross-platform TUI database management tool

# shellcheck disable=SC2034
libs_lic=MIT
libs_ver=0.7.0
libs_rev=1
libs_url=https://github.com/jorgerojas26/lazysql/archive/refs/tags/v0.7.0.tar.gz
libs_sha=735b5a987c8a84a699d34d0cba1a3bcce6d65a46cf608d96758df6257ca353f7

libs_args=(
)

libs_build() {
    go.setup

    go.build

    cmdlet.install "$libs_name"

    cmdlet.verify -- "$libs_name" --version
}

