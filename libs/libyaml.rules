# YAML parser

# shellcheck disable=SC2034
libs_name=libyaml
libs_lic="MIT"
libs_ver=0.2.7
libs_rev=1
libs_url=https://github.com/yaml/libyaml/archive/refs/tags/$libs_ver.tar.gz
libs_sha=7f76964485c67dc4e1537fdfd4ad5c8772bcef501c5451b617e43f831034994e

libs_args=(
    --disable-option-checking
    --enable-silent-rules
    --disable-dependency-tracking

    --enable-pic

    --disable-shared
    --enable-static
)

libs_build() {
    configure

    make

    cmdlet.pkgfile libyaml -- make install
}

# vim:ft=sh:syntax=bash:ff=unix:fenc=utf-8:et:ts=4:sw=4:sts=4
