# IETF QUIC protocol implementation
#
# shellcheck disable=SC2034
libs_lic="MIT"
libs_ver=1.26.0
libs_rev=1
libs_url=https://github.com/ngtcp2/ngtcp2/releases/download/v$libs_ver/ngtcp2-$libs_ver.tar.xz
libs_sha=7804aa0fa1c39942ba322a90805824c37231f7675b08d0c3cc4332858a7b085e

# ngtcp2 依赖于支持 QUIC API 的 TLS 库（例如 quictls、wolfSSL 或 BoringSSL）
libs_deps=(openssl)

libs_args=(
    --disable-option-checking
    --disable-dependency-tracking
    --disable-silent-rules

    --with-openssl

    --without-libev
    --without-libnghttp3

    # static only
    --disable-shared
    --enable-static
)

libs_build() {
    slogcmd ./buildconf

    configure

    make

    # fix libngtcp2.pc
    is_listed openssl libs_deps &&
        cmdlet.pkgconf lib/libngtcp2.pc -lngtcp2_crypto_ossl openssl || true

    cmdlet.pkgconf lib/libngtcp2.pc -DNGTCP2_STATICLIB

    cmdlet.pkgfile libngtcp2 -- make install
}

