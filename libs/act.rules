# Run your GitHub Actions locally 🚀

# shellcheck disable=SC2034
libs_name=act
libs_lic="MIT"
libs_ver=0.2.92
libs_rev=1
libs_url=https://github.com/nektos/act/archive/refs/tags/v$libs_ver.tar.gz
libs_sha=8b3ffbbb803007dfca19d5ea8e071876733d1390cfe358fe164ad67c6d7e549b

libs_args=(
)

libs_build() {
    go.setup

    go.build

    cmdlet.install act

    cmdlet.verify -- act --version
}

