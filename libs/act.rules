# Run your GitHub Actions locally 🚀

# shellcheck disable=SC2034
libs_name=act
libs_lic="MIT"
libs_ver=0.2.94
libs_rev=1
libs_url=https://github.com/nektos/act/archive/refs/tags/v$libs_ver.tar.gz
libs_sha=0e1881bcf1cc9217d1ff8f4c5dba56004a0609502e55b059c0518f4c49153a9a

libs_args=(
)

libs_build() {
    go.setup

    go.build

    cmdlet.install act

    cmdlet.verify -- act --version
}

