# Run your GitHub Actions locally 🚀

# shellcheck disable=SC2034
libs_name=act
libs_lic="MIT"
libs_ver=0.2.96
libs_rev=1
libs_url=https://github.com/nektos/act/archive/refs/tags/v$libs_ver.tar.gz
libs_sha=af2525e569e7d62cf164440d74c8467351b1791820909b17bcae8504097dd16c

libs_args=(
)

libs_build() {
    go.setup

    go.build

    cmdlet.install act

    cmdlet.verify -- act --version
}

