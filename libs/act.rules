# Run your GitHub Actions locally 🚀

# shellcheck disable=SC2034
libs_name=act
libs_lic="MIT"
libs_ver=0.2.93
libs_rev=1
libs_url=https://github.com/nektos/act/archive/refs/tags/v$libs_ver.tar.gz
libs_sha=47a24e03e0ba9f8279dd835b1e334326af486b6046dd7d7915599fa38adc5519

libs_args=(
)

libs_build() {
    go.setup

    go.build

    cmdlet.install act

    cmdlet.verify -- act --version
}

