# GO Simple Tunnel - a simple tunnel written in golang

# shellcheck disable=SC2034
libs_lic='MIT'
libs_ver=3.3.1
libs_rev=1
libs_url=https://github.com/go-gost/gost/archive/refs/tags/v3.3.1.tar.gz
libs_sha=3b5241edbc69d9578a37b3e950cf02ca7a7dc2aa2f688457affc63d966b93012
libs_dep=()

# configure args
libs_args=()
libs_build() {
    go.build ./cmd/gost

    cmdlet.install  gost
    cmdlet.verify --    gost
}

