# GO Simple Tunnel - a simple tunnel written in golang

# shellcheck disable=SC2034
libs_lic='MIT'
libs_ver=3.3.3
libs_rev=1
libs_url=https://github.com/go-gost/gost/archive/refs/tags/v3.3.3.tar.gz
libs_sha=2c79c7675894cfd5849d646f037dc82e4278cd43439e3e0b0160fdf112269564
libs_dep=()

# configure args
libs_args=()
libs_build() {
    go.build ./cmd/gost

    cmdlet.install  gost
    cmdlet.verify --    gost
}

