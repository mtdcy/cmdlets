# GO Simple Tunnel - a simple tunnel written in golang

# shellcheck disable=SC2034
libs_lic='MIT'
libs_ver=3.3.2
libs_rev=1
libs_url=https://github.com/go-gost/gost/archive/refs/tags/v3.3.2.tar.gz
libs_sha=838674347bfd7a7df43cab5ca25a21992a247fe50fe61e9a12497d5a1699a3d5
libs_dep=()

# configure args
libs_args=()
libs_build() {
    go.build ./cmd/gost

    cmdlet.install  gost
    cmdlet.verify --    gost
}

