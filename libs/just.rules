# Handy way to save and run project-specific commands

# shellcheck disable=SC2034
libs_ver=1.59.0
libs_rev=1
libs_url=https://github.com/casey/just/archive/refs/tags/1.59.0.tar.gz
libs_sha=20f876880851f1cc67fc7eb7589c7f7ccaa7612d827feac75797cf4a6ed729aa
libs_dep=()

# configure args
libs_args=(
)

libs_build() {
    cargo.setup

    cargo.build

    cmdlet.install "$(cargo.locate $libs_name)"

    cmdlet.verify "$libs_name"
}

