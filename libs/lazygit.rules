# Simple terminal UI for git commands

# shellcheck disable=SC2034
libs_name=lazygit
libs_lic="MIT"
libs_ver=0.66.1
libs_rev=1
libs_url=https://github.com/jesseduffield/lazygit/archive/refs/tags/v$libs_ver.tar.gz
libs_sha=75d82496e7e99a4ae58279efd37186ee5d10de9bb751077775487639c07185af

# configure args
libs_args=(
)

libs_build() {
    go version

    go clean

    go build .

    cmdlet.install lazygit

    cmdlet.verify -- lazygit --version
}

