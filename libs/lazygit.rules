# Simple terminal UI for git commands

# shellcheck disable=SC2034
libs_name=lazygit
libs_lic="MIT"
libs_ver=0.66.2
libs_rev=1
libs_url=https://github.com/jesseduffield/lazygit/archive/refs/tags/v$libs_ver.tar.gz
libs_sha=fcaad0909af765ef87bd873164a4de78435515ab4d8b04f58d6ad51e8ecd00e5

# configure args
libs_args=(
)

libs_build() {
    go version

    go clean

    go build .

    cmdlet.install lazygit

    cmdlet.verify -- lazygit --version
}

# vim:ft=sh:syntax=bash:ff=unix:fenc=utf-8:et:ts=4:sw=4:sts=4
