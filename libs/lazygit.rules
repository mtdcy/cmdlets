# Simple terminal UI for git commands

# shellcheck disable=SC2034
libs_name=lazygit
libs_lic="MIT"
libs_ver=0.66.0
libs_rev=1
libs_url=https://github.com/jesseduffield/lazygit/archive/refs/tags/v$libs_ver.tar.gz
libs_sha=704b14509dae4c0212754d60d1c00181aea79c0734aafa2c83c89301dba1aefd

# configure args
libs_args=(
)

libs_build() {
    go version

    go clean

    go build .

    cmdlet.install lazygit

    cmdlet.verify -- lazygit --version
}

