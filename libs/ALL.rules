# basic cmdlets of all target platforms

libs_ver=1.0
libs_rev=1
libs_url=https://cmdlets.mtdcy.top/latest/README.md

libs_deps=(
    # basic
    bash coreutils grep gawk gsed findutils file
    # +curl +git
    curl git less diffutils
    # compress and decompress
    gtar gzip xz
    # programming (make + shell)
    gmake ctags lazygit checkmake shfmt delta shellcheck
    # multimedia
    ffmpeg
)

# unix tools
case "$LIBS_TARGET" in
    linux | darwin)
        # windows only needs a bash shell, but unix needs different versions
        libs_deps+=(bash@3.2 bash@4.4)
        # system
        libs_deps+=(ripgrep htop)
        # docker
        libs_deps+=(docker act ctop)
        # network
        libs_deps+=(socat iperf3)
        ;;
esac

libs_build() {
    slogi "$_EMOJI_OK" "All basic cmdlets are ready."
}

